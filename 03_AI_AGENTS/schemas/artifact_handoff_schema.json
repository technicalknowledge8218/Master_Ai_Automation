{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MasterAIArtifactHandoffSchema",
  "type": "object",
  "required": [
    "handoff_id",
    "task_id",
    "source_agent",
    "target_agent",
    "artifacts",
    "status",
    "timestamp"
  ],
  "properties": {
    "handoff_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "source_agent": {
      "type": "string"
    },
    "target_agent": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "artifact_type", "path", "sha256"],
        "properties": {
          "artifact_id": {"type": "string"},
          "artifact_type": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string"}
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "TRANSFERRED", "REJECTED", "VERIFIED"]
    },
    "verification_notes": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
