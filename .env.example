# ==============================================================================
# MASTER AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local overrides.
# Never commit real API secrets or credentials to version control.

# --- Core Server Configuration ---
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=master-ai-local-development-secret-key-32bytes-minimum

# --- Local LLM & Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=60

# --- LiteLLM Gateway ---
LITELLM_MODE=local
LITELLM_FALLBACK_TO_MOCK=true

# --- Vector Database & RAG Memory (Qdrant Embedded) ---
QDRANT_MODE=embedded
QDRANT_STORAGE_PATH=04_LLM_AND_AI/rag_systems/qdrant_db

# --- Media & FFmpeg ---
FFMPEG_PATH=ffmpeg

# --- Resource & Storage Constraints ---
MAX_LOCAL_MODEL_SIZE_GB=2.73
MAX_CPU_THREADS=8
ENABLE_DOCKER=false
ENABLE_WSL2=false

# --- Cloud API Providers (Optional, Disabled in Phase 1) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
